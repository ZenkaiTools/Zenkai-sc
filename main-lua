	toggle("Enable Silent Aim", CFG.SilentAim, function(v) CFG.SilentAim = v end)
	dropdown("Target Mode", {"Survivor", "Killer", "Zombie"}, CFG.TargetMode, function(v) CFG.TargetMode = v end)
	dropdown("Target Part", {"Head", "Torso", "Random"}, CFG.TargetPart, function(v) CFG.TargetPart = v end)
	toggle("Auto Face", CFG.AutoFace, function(v) CFG.AutoFace = v end)
	toggle("Auto Activate", CFG.AutoActivate, function(v) CFG.AutoActivate = v end)
	toggle("Remote Spam", CFG.RemoteSpam, function(v) CFG.RemoteSpam = v end)
	toggle("Hide Animation", CFG.HideAnim, function(v) CFG.HideAnim = v end)
	toggle("Wall Check", CFG.WallCheck, function(v) CFG.WallCheck = v end)
	toggle("Aim Prediction", CFG.AimPredict, function(v) CFG.AimPredict = v end)
	section("RANGE")
	slider("Max Distance", 5, 100, CFG.MaxDist, function(v) CFG.MaxDist = v end)
