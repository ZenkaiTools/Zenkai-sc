local function removeESP(p)
	if espObjects[p] then
		espObjects[p].Box:Destroy()
		espObjects[p].HL:Destroy()
		espObjects[p] = nil
	end
end

-- ESP Gen scan
local genObjects = {}
local function scanGen()
	if not CFG.ESPGen then
		for _, g in pairs(genObjects) do g.HL:Destroy(); g.Box:Destroy() end
		genObjects = {}
		return
	end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") or obj:IsA("BasePart") then
			local n = obj.Name:lower()
			if n:find("generator") or n:find("gen") or n:find("fuse") or n:find("repair") then
				if not genObjects[obj] then
					local hl = Instance.new("Highlight")
					hl.FillColor = Color3.fromRGB(0, 150, 255)
					hl.OutlineColor = Color3.fromRGB(0, 255, 255)
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillTransparency = 0.5
					hl.Parent = espFolder
					hl.Adornee = obj
					genObjects[obj] = {HL = hl}
				end
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	if not CFG.ESP then
		for _, o in pairs(espObjects) do o.Box.Visible = false; o.HL.Enabled = false end
		return
	end
	for p, o in pairs(espObjects) do
		local char = p.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
				if dist <= CFG.ESPMaxDist then
					local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						local size = math.clamp(1500 / dist, 20, 200)
						o.Box.Visible = CFG.ESPBox
						o.Box.Size = UDim2.new(0, size, 0, size * 1.5)
						o.Box.Position = UDim2.new(0, pos.X - size/2, 0, pos.Y - (size*1.5)/2)
						o.Name.Visible = CFG.ESPName
						o.Name.Text = p.Name
						o.Dist.Visible = CFG.ESPDist
						o.Dist.Text = math.floor(dist) .. "m"
						o.HP.Visible = CFG.ESPHealth
						o.HP.Size = UDim2.new(0, 3, hum.Health / hum.MaxHealth, 0)
						o.HP.BackgroundColor3 = Color3.fromRGB(
							255 * (1 - hum.Health / hum.MaxHealth),
							255 * (hum.Health / hum.MaxHealth), 0)
						if CFG.Chams then
							o.HL.Enabled = true
							o.HL.Adornee = char
						else
							o.HL.Enabled = false
						end
					else
						o.Box.Visible = false
						o.HL.Enabled = false
					end
				else
					o.Box.Visible = false
					o.HL.Enabled = false
				end
			else
				o.Box.Visible = false
				o.HL.Enabled = false
			end
		else
			o.Box.Visible = false
			o.HL.Enabled = false
		end
	end
	scanGen()
end)

