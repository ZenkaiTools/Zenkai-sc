-- LOGIC: AUTO DAGGER
-- ═══════════════════════════════════════════════════════════════
local lastParry = 0
RunService.Heartbeat:Connect(function()
	if not CFG.AutoDagger then return end
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	local now = tick()
	if now - lastParry < 0.2 then return end
	local killer, shortest = nil, CFG.ParryDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local khrp = p.Character:FindFirstChild("HumanoidRootPart")
			if khrp then
				local d = (khrp.Position - hrp.Position).Magnitude
				if d < shortest then shortest = d; killer = p end
			end
		end
	end
	if killer then
		local kChar = killer.Character
		local kHum = kChar and kChar:FindFirstChild("Humanoid")
		local kAnim = kHum and kHum:FindFirstChildOfClass("Animator")
		if kAnim then
			for _, track in ipairs(kAnim:GetPlayingAnimationTracks()) do
				local n = track.Name:lower()
				if n:find("attack") or n:find("slash") or n:find("stab") or n:find("swing") then
					lastParry = now
					local dagger = char:FindFirstChildOfClass("Tool")
					if dagger and dagger.Name:lower():find("dagger") then
						dagger:Activate()
					else
						local bp = LP:FindFirstChild("Backpack")
						if bp then
							for _, t in ipairs(bp:GetChildren()) do
								if t:IsA("Tool") and t.Name:lower():find("dagger") then
									hum:EquipTool(t)
									task.wait(0.05)
									t:Activate()
									break
								end
							end
						end
					end
				end
			end
		end
	end
end)

