-- LOGIC: BYPASS UNHOOK + SINK
-- ═══════════════════════════════════════════════════════════════
local originalPos = nil
local unhooked = false
RunService.Heartbeat:Connect(function()
	if not CFG.AutoUnhook then return end
	local char = LP.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not hrp or not hum then return end
	-- Cek apakah lagi di-hook (cari attachment / tool "hook" di karakter)
	local isHooked = false
	for _, obj in ipairs(char:GetDescendants()) do
		if obj.Name:lower():find("hook") or obj.Name:lower():find("tancep") then
			isHooked = true
			break
		end
	end
	if isHooked then
		-- Trigger unhook
		for _, v in ipairs(game:GetDescendants()) do
			if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
				local n = v.Name:lower()
				if n:find("unhook") or n:find("escape") or n:find("struggle") or n:find("release") then
					pcall(function() v:FireServer() end)
				end
			end
		end
		if not unhooked then
			unhooked = true
			originalPos = hrp.Position
			if CFG.SinkUnder then
				hrp.CFrame = CFrame.new(hrp.Position - Vector3.new(0, CFG.SinkDepth, 0))
			end
			if CFG.InvisibleAfterUnhook then
				for _, obj in ipairs(char:GetDescendants()) do
					if obj:IsA("BasePart") then
						obj.Transparency = 1
					end
					if obj:IsA("Decal") then
						obj.Transparency = 1
					end
				end
				task.wait(3)
				for _, obj in ipairs(char:GetDescendants()) do
					if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
						obj.Transparency = 0
					end
				end
			end
		end
	else
		unhooked = false
	end
end)

