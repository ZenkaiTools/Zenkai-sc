local espFolder = Instance.new("Folder", GUI)
espFolder.Name = "VD_ESP"
local espObjects = {}

local function createESP(p)
	if p == LP or espObjects[p] then return end
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = espFolder
	local stroke = Instance.new("UIStroke", box)
	stroke.Thickness = 1.5
	
	local name = Instance.new("TextLabel", box)
	name.Size = UDim2.new(1, 0, 0, 14)
	name.Position = UDim2.new(0, 0, 0, -16)
	name.BackgroundTransparency = 1
	name.TextStrokeTransparency = 0
	name.TextStrokeColor3 = Color3.new(0, 0, 0)
	name.Font = Enum.Font.GothamBold
	name.TextSize = 10
	name.TextColor3 = Color3.new(1, 1, 1)
	
	local dist = Instance.new("TextLabel", box)
	dist.Size = UDim2.new(1, 0, 0, 12)
	dist.Position = UDim2.new(0, 0, 1, 2)
	dist.BackgroundTransparency = 1
	dist.TextStrokeTransparency = 0
	dist.TextStrokeColor3 = Color3.new(0, 0, 0)
	dist.Font = Enum.Font.Gotham
	dist.TextSize = 9
	dist.TextColor3 = Color3.fromRGB(0, 255, 255)
	
	local hp = Instance.new("Frame", box)
	hp.Size = UDim2.new(0, 3, 1, 0)
	hp.Position = UDim2.new(1, 3, 0, 0)
	hp.BorderSizePixel = 0
	hp.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	
	local hl = Instance.new("Highlight", box)
	hl.Name = "Cham"
	hl.FillTransparency = 0.5
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = nil
	
	espObjects[p] = {Box = box, Stroke = stroke, Name = name, Dist = dist, HP = hp, HL = hl}
end

local function removeESP(p)
	if espObjects[p] then
		espObjects[p].Box:Destroy()
		espObjects[p] = nil
	end
end

-- ═══════════════════════════════════════════════════════════════
-- ESP UPDATE
-- ═══════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
	if not CFG.ESP then
		for _, o in pairs(espObjects) do o.Box.Visible = false; o.HL.Enabled = false end
		return
	end
	
	for p, o in pairs(espObjects) do
		local char = p.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
				if dist <= CFG.ESPMaxDist then
					local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						local size = math.clamp(1500 / dist, 20, 200)
						o.Box.Visible = CFG.ESPBox
						o.Box.Size = UDim2.new(0, size, 0, size * 1.5)
						o.Box.Position = UDim2.new(0, pos.X - size/2, 0, pos.Y - (size*1.5)/2)
						o.Stroke.Color = Color3.fromRGB(255, 0, 0)
						o.Name.Visible = CFG.ESPName
						o.Name.Text = p.Name
						o.Dist.Visible = CFG.ESPDist
						o.Dist.Text = math.floor(dist) .. "m"
						o.HP.Visible = CFG.ESPHealth
						o.HP.Size = UDim2.new(0, 3, hum.Health / hum.MaxHealth, 0)
						o.HP.BackgroundColor3 = Color3.fromRGB(
							255 * (1 - hum.Health / hum.MaxHealth),
							255 * (hum.Health / hum.MaxHealth), 0)
						if CFG.Chams then
							o.HL.Enabled = true
							o.HL.Adornee = char
							o.HL.FillColor = Color3.fromRGB(255, 0, 0)
							o.HL.OutlineColor = Color3.fromRGB(255, 100, 100)
						else
							o.HL.Enabled = false
						end
					else
						o.Box.Visible = false
						o.HL.Enabled = false
					end
				else
					o.Box.Visible = false
					o.HL.Enabled = false
				end
			else
				o.Box.Visible = false
				o.HL.Enabled = false
			end
		else
			o.Box.Visible = false
			o.HL.Enabled = false
		end
	end
end)

