local function toggle(name, def, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -6, 0, 30)
	f.BackgroundColor3 = Color3.fromRGB(18, 26, 38)
	f.BorderSizePixel = 0
	f.Parent = Content
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -60, 1, 0)
	l.Position = UDim2.new(0, 10, 0, 0)
	l.BackgroundTransparency = 1
	l.Text = name
	l.TextColor3 = Color3.fromRGB(200, 220, 235)
	l.Font = Enum.Font.Gotham
	l.TextSize = 11
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 44, 0, 26)
	b.Position = UDim2.new(1, -52, 0.5, -13)
	b.BackgroundColor3 = def and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(40, 55, 75)
	b.Text = ""
	b.Parent = f
	Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
	local c = Instance.new("Frame")
	c.Size = UDim2.new(0, 18, 0, 18)
	c.Position = def and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 4, 0.5, -9)
	c.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	c.BorderSizePixel = 0
	c.Parent = b
	Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
	local st = def
	b.MouseButton1Click:Connect(function()
		st = not st
		b.BackgroundColor3 = st and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(40, 55, 75)
		TweenService:Create(c, TweenInfo.new(0.12), {
			Position = st and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 4, 0.5, -9)
		}):Play()
		if cb then cb(st) end
	end)
end

local function dropdown(name, opts, def, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -6, 0, 30)
	f.BackgroundColor3 = Color3.fromRGB(18, 26, 38)
	f.BorderSizePixel = 0
	f.Parent = Content
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(0, 100, 1, 0)
	l.Position = UDim2.new(0, 10, 0, 0)
	l.BackgroundTransparency = 1
	l.Text = name
	l.TextColor3 = Color3.fromRGB(200, 220, 235)
	l.Font = Enum.Font.Gotham
	l.TextSize = 11
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 110, 0, 22)
	b.Position = UDim2.new(1, -118, 0.5, -11)
	b.BackgroundColor3 = Color3.fromRGB(30, 45, 65)
	b.Text = def
	b.TextColor3 = Color3.fromRGB(0, 255, 255)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.Parent = f
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
	local i = 1
	for k, v in ipairs(opts) do if v == def then i = k break end end
	b.MouseButton1Click:Connect(function()
		i = i % #opts + 1
		b.Text = opts[i]
		if cb then cb(opts[i]) end
	end)
end

local function slider(name, min, max, def, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -6, 0, 46)
	f.BackgroundColor3 = Color3.fromRGB(18, 26, 38)
	f.BorderSizePixel = 0
	f.Parent = Content
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -70, 0, 18)
	l.Position = UDim2.new(0, 10, 0, 4)
	l.BackgroundTransparency = 1
	l.Text = name
	l.TextColor3 = Color3.fromRGB(200, 220, 235)
	l.Font = Enum.Font.Gotham
	l.TextSize = 10
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f
	local v = Instance.new("TextLabel")
	v.Size = UDim2.new(0, 60, 0, 18)
	v.Position = UDim2.new(1, -70, 0, 4)
	v.BackgroundTransparency = 1
	v.Text = tostring(def)
	v.TextColor3 = Color3.fromRGB(0, 255, 255)
	v.Font = Enum.Font.GothamBold
	v.TextSize = 10
	v.TextXAlignment = Enum.TextXAlignment.Right
	v.Parent = f
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -20, 0, 10)
	bar.Position = UDim2.new(0, 10, 0, 28)
	bar.BackgroundColor3 = Color3.fromRGB(40, 55, 75)
	bar.BorderSizePixel = 0
	bar.Parent = f
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 16, 0, 16)
	dot.Position = UDim2.new((def - min) / (max - min), -8, 0.5, -8)
	dot.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
	dot.BorderSizePixel = 0
	dot.Parent = bar
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	local drag = false
	local function upd(inp)
		local r = math.clamp((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + (max - min) * r)
		fill.Size = UDim2.new(r, 0, 1, 0)
		dot.Position = UDim2.new(r, -8, 0.5, -8)
		v.Text = tostring(val)
		if cb then cb(val) end
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true; upd(i)
		end
	end)
	bar.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			upd(i)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = false
		end
	end)
end

