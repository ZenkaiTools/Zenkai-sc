local function toggle(name, def, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -6, 0, 26)
	f.BackgroundColor3 = Color3.fromRGB(18, 26, 38)
	f.BorderSizePixel = 0
	f.Parent = Content
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
	
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -55, 1, 0)
	l.Position = UDim2.new(0, 10, 0, 0)
	l.BackgroundTransparency = 1
	l.Text = name
	l.TextColor3 = Color3.fromRGB(200, 220, 235)
	l.Font = Enum.Font.Gotham
	l.TextSize = 11
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f
	
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 34, 0, 18)
	b.Position = UDim2.new(1, -42, 0.5, -9)
	b.BackgroundColor3 = def and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(40, 55, 75)
	b.Text = ""
	b.Parent = f
	Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
	
	local c = Instance.new("Frame")
	c.Size = UDim2.new(0, 14, 0, 14)
	c.Position = def and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
	c.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	c.BorderSizePixel = 0
	c.Parent = b
	Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
	
	local st = def
	b.MouseButton1Click:Connect(function()
		st = not st
		b.BackgroundColor3 = st and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(40, 55, 75)
		TweenService:Create(c, TweenInfo.new(0.12), {
			Position = st and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
		}):Play()
		if cb then cb(st) end
	end)
end

