local function makeTab(name)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 55, 0, 24)
	b.BackgroundColor3 = Color3.fromRGB(20, 30, 45)
	b.Text = name
	b.TextColor3 = Color3.fromRGB(120, 180, 220)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.Parent = TabBar
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	
	b.MouseButton1Click:Connect(function()
		for _, t in ipairs(TabBar:GetChildren()) do
			if t:IsA("TextButton") then
				t.BackgroundColor3 = (t == b) and Color3.fromRGB(0, 120, 180) or Color3.fromRGB(20, 30, 45)
				t.TextColor3 = (t == b) and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(120, 180, 220)
			end
		end
		-- Clear content
		for _, c in ipairs(Content:GetChildren()) do
			if not c:IsA("UIListLayout") then c:Destroy() end
		end
		-- Build tab
		if name == "Combat" then buildCombat()
		elseif name == "ESP" then buildESP()
		elseif name == "Veil" then buildVeil()
		elseif name == "Survivor" then buildSurvivor()
		elseif name == "Move" then buildMove()
		elseif name == "Visual" then buildVisual()
		elseif name == "Misc" then buildMisc() end
	end)
	return b
end

