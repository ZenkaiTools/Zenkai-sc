function applyVisual()
	Lighting.Brightness = CFG.Fullbright and 3 or CFG.Brightness
	Lighting.ClockTime = CFG.ClockTime
	Lighting.FogEnd = 100000
	if CFG.NoShadow then Lighting.GlobalShadows = false end
	if CFG.NoEffects then
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then v.Enabled = false end
		end
	end
	if CFG.CleanSky then
		local sky = Lighting:FindFirstChildOfClass("Sky")
		if sky then sky:Destroy() end
	end
end

-- ═══════════════════════════════════════════════════════════════
-- LOGIC: GET TARGET
-- ═══════════════════════════════════════════════════════════════
local function getTarget()
	local char = LP.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	
	local closest, shortest = nil, CFG.MaxDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local thrp = p.Character:FindFirstChild("HumanoidRootPart")
			local thum = p.Character:FindFirstChild("Humanoid")
			if thrp and thum and thum.Health > 0 then
				local dist = (thrp.Position - hrp.Position).Magnitude
				if dist < shortest then
					shortest = dist
					closest = thrp
				end
			end
		end
	end
	return closest
end

-- ═══════════════════════════════════════════════════════════════
-- LOGIC: SILENT AIM
-- ═══════════════════════════════════════════════════════════════
local lastFire = 0
RunService.Heartbeat:Connect(function()
	if not CFG.SilentAim then return end
	local char = LP.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	
	local target = getTarget()
	if not target then return end
	
	local aimPos = target.Position
	if CFG.AimPredict then
		local dist = (target.Position - hrp.Position).Magnitude
		aimPos = aimPos + target.Velocity * (dist / CFG.PredictSpeed)
	end
	
	if CFG.AutoFace then
		local look = CFrame.new(hrp.Position, aimPos)
		hrp.CFrame = CFrame.new(hrp.Position) * (look - look.Position)
	end
	
	local now = tick()
	if now - lastFire >= CFG.FireDelay then
		lastFire = now
		local tool = char:FindFirstChildOfClass("Tool")
		if tool and CFG.AutoActivate then tool:Activate() end
		
		if CFG.RemoteSpam then
			for _, v in ipairs(game:GetDescendants()) do
				if v:IsA("RemoteEvent") then
					local n = v.Name:lower()
					if n:find("hit") or n:find("damage") or n:find("attack") or n:find("spear") or n:find("melee") then
						pcall(function() v:FireServer(target, aimPos, tool) end)
					end
				end
			end
		end
	end
end)

-- ═══════════════════════════════════════════════════════════════
-- LOGIC: AUTO DAGGER (PARRY)
-- ═══════════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
	if not CFG.AutoDagger then return end
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	
	local killer, shortest = nil, CFG.ParryDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local khrp = p.Character:FindFirstChild("HumanoidRootPart")
			if khrp then
				local d = (khrp.Position - hrp.Position).Magnitude
				if d < shortest then shortest = d; killer = p end
			end
		end
	end
	
	if killer then
		local kChar = killer.Character
		local kHum = kChar and kChar:FindFirstChild("Humanoid")
		local kAnim = kHum and kHum:FindFirstChildOfClass("Animator")
		if kAnim then
			for _, track in ipairs(kAnim:GetPlayingAnimationTracks()) do
				local n = track.Name:lower()
				if n:find("attack") or n:find("slash") or n:find("stab") or n:find("swing") then
					local dagger = char:FindFirstChildOfClass("Tool")
					if dagger and dagger.Name:lower():find("dagger") then
						task.wait(CFG.ParryDelay)
						dagger:Activate()
					else
						local bp = LP:FindFirstChild("Backpack")
						if bp then
							for _, t in ipairs(bp:GetChildren()) do
								if t:IsA("Tool") and t.Name:lower():find("dagger") then
									hum:EquipTool(t)
									task.wait(CFG.ParryDelay)
									t:Activate()
									break
								end
							end
						end
					end
				end
			end
		end
	end
end)

