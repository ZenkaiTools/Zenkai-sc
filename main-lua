function buildMove()
	section("MOVEMENT")
	toggle("Speed Hack", CFG.SpeedHack, function(v)
		CFG.SpeedHack = v
		local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
		if h then h.WalkSpeed = v and CFG.SpeedValue or 16 end
	end)
	slider("Speed Value", 20, 200, CFG.SpeedValue, function(v)
		CFG.SpeedValue = v
		if CFG.SpeedHack then
			local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
			if h then h.WalkSpeed = v end
		end
	end)
	toggle("Jump Power", CFG.JumpPower, function(v)
		CFG.JumpPower = v
		local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
		if h then
			h.UseJumpPower = v
			h.JumpPower = v and CFG.JumpValue or 50
		end
	end)
	slider("Jump Value", 50, 300, CFG.JumpValue, function(v) CFG.JumpValue = v end)
	toggle("Infinite Jump", CFG.InfJump, function(v) CFG.InfJump = v end)
	toggle("Fly", CFG.Fly, function(v) CFG.Fly = v end)
	slider("Fly Speed", 20, 300, CFG.FlySpeed, function(v) CFG.FlySpeed = v end)
	toggle("Noclip", CFG.Noclip, function(v) CFG.Noclip = v end)
	toggle("God Mode", CFG.GodMode, function(v)
		CFG.GodMode = v
		local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
		if h then h.MaxHealth = v and math.huge or 100; h.Health = v and math.huge or 100 end
	end)
end

function buildVisual()
	section("VISUAL")
	toggle("Fullbright", CFG.Fullbright, function(v) CFG.Fullbright = v; applyVisual() end)
	toggle("No Shadow", CFG.NoShadow, function(v) CFG.NoShadow = v; applyVisual() end)
	toggle("Low Graphics", CFG.LowGraphics, function(v) CFG.LowGraphics = v; applyVisual() end)
	toggle("No Screen Effects", CFG.NoEffects, function(v) CFG.NoEffects = v; applyVisual() end)
	toggle("Clean Sky", CFG.CleanSky, function(v) CFG.CleanSky = v; applyVisual() end)
	section("CLOCK & AMBIENT")
	slider("Clock Time", 0, 24, CFG.ClockTime, function(v) CFG.ClockTime = v; applyVisual() end)
	slider("Brightness", 0, 5, CFG.Brightness, function(v) CFG.Brightness = v; applyVisual() end)
	slider("Max Zoom", 100, 5000, CFG.Zoom, function(v)
		CFG.Zoom = v
		LP.CameraMaxZoomDistance = v
	end)
end

function buildMisc()
	section("EXTRA")
	toggle("Kill Aura", CFG.KillAura, function(v) CFG.KillAura = v end)
	toggle("Auto Farm", CFG.AutoFarm, function(v) CFG.AutoFarm = v end)
	toggle("Anti AFK", CFG.AntiAFK, function(v) CFG.AntiAFK = v end)
	toggle("FPS Boost", CFG.FPSBoost, function(v)
		CFG.FPSBoost = v
		if v then
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			Lighting.GlobalShadows = false
		end
	end)
end

