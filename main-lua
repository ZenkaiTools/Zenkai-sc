-- LOGIC: SILENT AIM
-- ═══════════════════════════════════════════════════════════════
local lastFire = 0
RunService.Heartbeat:Connect(function()
	if CFG.FOVCircle and CFG.SilentAim then
		FOVCircle.Visible = true
		FOVCircle.Size = UDim2.new(0, CFG.FOV, 0, CFG.FOV)
		FOVCircle.Position = UDim2.new(0.5, -CFG.FOV/2, 0.5, -CFG.FOV/2)
	else
		FOVCircle.Visible = false
	end
	
	if not CFG.SilentAim then return end
	local char = LP.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	
	local target, targetPart = getTarget()
	if not target or not targetPart then return end
	
	InfoPanel.Text = string.format("  Target: %s  |  Dist: %d  |  Speed: %d",
		target.Name, math.floor((targetPart.Position - hrp.Position).Magnitude), math.floor(hum.WalkSpeed))
	
	if CFG.AutoFace then
		local look = CFrame.new(hrp.Position, targetPart.Position)
		hrp.CFrame = CFrame.new(hrp.Position) * (look - look.Position)
	end
	
	local now = tick()
	local delay = CFG.FireDelay
	if CFG.RandomDelay then delay = delay + math.random() * 0.05 end
	if now - lastFire >= delay then
		lastFire = now
		local tool = char:FindFirstChildOfClass("Tool")
		if tool and (CFG.AutoActivate or CFG.AutoShoot) then tool:Activate() end
		for _, v in ipairs(game:GetDescendants()) do
			if v:IsA("RemoteEvent") then
				local n = v.Name:lower()
				if n:find("hit") or n:find("damage") or n:find("attack") or n:find("shoot") or n:find("fire") then
					pcall(function() v:FireServer(targetPart, targetPart.Position, tool) end)
				end
			end
		end
	end
end)

